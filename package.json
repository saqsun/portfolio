{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/create-spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --ignore-path .oxfmtignore",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "mixpanel-browser": "^2.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
